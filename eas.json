{
  "cli": {
    "version": ">= 19.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0",
        "RCT_USE_RN_DEP": "0",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://pench.api.polynexus.in/api/",
        "EXPO_PUBLIC_ENV": "production"
      },
      "ios": {
        "buildArtifactPaths": [
          "ios/build/Build/Products/*/*.ipa",
          "ios/build/Build/Products/*/*.dSYM"
        ]
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6803119085",
        "appleTeamId": "3WXZANBK4P"
      }
    }
  }
}
